@model UserViewModel
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="display-6 text-center fw-bolder">
	@{
		if (TempData["Message"] == "Users saved successfully!")
		{
			<p class="text-success">@TempData["Message"]</p>
		}
		else
		{
			<p class="text-danger">@TempData["Message"] </p>
		}
	}
	</div>
@{
	if (Model.IsSaveButtonShowing)
	{
		<form asp-controller="User" asp-action="SaveUser" method="post">
			@Html.AntiForgeryToken()
			<table class ="table table-striped table-bordered table-hover">
				<thead class="table-primary">
					<tr>
						<th>Name</th>
						<th>Username</th>
						<th>Email</th>
						<th>Phone</th>
						<th>Website</th>
						<th>Street</th>
						<th>Suite</th>
						<th>City</th>
						<th>Zipcode</th>
						<th>Lat</th>
						<th>Lng</th>
						<th>Note</th>
						<th>IsActive</th>
					</tr>
				</thead>
				<tbody>
					@{
						// Fills table with users
					}
					@for (int i = 0; i < Model.Users.Count; i++)
					{
						<tr>
							<td class="lead">@Model.Users[i].Name</td>
							<input name="users[@i].Name" type="text" value="@Model.Users[i].Name" hidden />
							<td class="lead">@Model.Users[i].NotUsername</td>
							<input name="users[@i].NotUsername" type="text" value="@Model.Users[i].NotUsername" hidden />
							<td class="lead">@Model.Users[i].Email</td>
							<input name="users[@i].Email" type="text" value="@Model.Users[i].Email" hidden />
							<td class="lead">@Model.Users[i].Phone</td>
							<input name="users[@i].Phone" type="text" value="@Model.Users[i].Phone" hidden />
							<td class="lead">@Model.Users[i].Website</td>
							<input name="users[@i].Website" type="text" value="@Model.Users[i].Website" hidden />
							<td class="lead">@Model.Users[i].Address.Street</td>
							<input name="users[@i].Address.Street" type="text" value="@Model.Users[i].Address.Street" hidden />
							<td class="lead">@Model.Users[i].Address.Suite</td>
							<input name="users[@i].Address.Suite" type="text" value="@Model.Users[i].Address.Suite" hidden />
							<td class="lead">@Model.Users[i].Address.City</td>
							<input name="users[@i].Address.City" type="text" value="@Model.Users[i].Address.City" hidden />
							<td class="lead">@Model.Users[i].Address.ZipCode</td>
							<input name="users[@i].Address.ZipCode" type="text" value="@Model.Users[i].Address.ZipCode" hidden />
							<td class="lead">@Model.Users[i].Address.Lat</td>
							<input name="users[@i].Address.Lat" type="text" value="@Model.Users[i].Address.Lat" hidden />
							<td class="lead">@Model.Users[i].Address.Lng</td>
							<input name="users[@i].Address.Lng" type="text" value="@Model.Users[i].Address.Lng" hidden />
							<td><input name="users[@i].Note" class="rounded border-primary" type="text" value="@Model.Users[i].Note" /></td>
							<td><input name="users[@i].IsActive" type="checkbox" class="form-check-input" value="true" @(Model.Users[i].IsActive ? "checked" : "") /></td>
							<input name="users[@i].Id" type="hidden" value="@Model.Users[i].Id" />
						</tr>
					}
				</tbody>
			</table>
			<button class="btn-primary rounded w-100 mt-3 btn-lg" style="height:50px" type="submit">Save All</button>
		</form>
	}
	else
	{
		<p class="display-2 text-center">Click here to load user data</p>
		<form asp-action="GetUsersFromAPI" asp-controller="User">
			<button class="btn-primary rounded btn-lg w-100 mt-4" style="height: 50px;" type="submit">Load Data</button>
		</form>
	}
}
